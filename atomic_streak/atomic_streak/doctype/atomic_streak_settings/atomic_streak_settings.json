   "label": "Provider",
   "options": "Anthropic",
   "default": "Anthropic",
   "depends_on": "ai_enabled",
   "description": "Claude, called from this server only. The key never reaches the browser."
  },
  {
   "fieldname": "ai_model",
   "fieldtype": "Data",
   "label": "Model",
   "default": "claude-opus-5-5",
   "depends_on": "ai_enabled"
  },
  {
   "fieldname": "ai_col",
   "fieldtype": "Column Break"
  },
  {
