 "fields": [
  {
   "fieldname": "accounts_section",
   "fieldtype": "Section Break",
   "label": "Accounts"
  },
  {
   "fieldname": "allow_signup",
   "fieldtype": "Check",
   "label": "Allow public sign-up at /atomic-streak/signup",
   "default": "1"
  },
  {
   "fieldname": "ai_section",
   "fieldtype": "Section Break",
   "label": "AI Coach",
   "description": "Optional. Without a provider the coach gives rule-based tips from the user's own data."
  },
  {
   "fieldname": "ai_enabled",
   "fieldtype": "Check",
   "label": "Enable AI provider"
  },
  {
   "fieldname": "ai_provider",
